# 复制为 .env 后填写。所有变量都可用 GYRA_USER_ 前缀覆盖 config。
GYRA_USER_CONFIG=configs/auth.toml

# ── 服务 ──
GYRA_USER_DATA_DIR=data
# development | staging | production
# production 会启用启动自检：弱密钥、http 地址、缺 public_base_url 直接拒绝启动
GYRA_USER_ENVIRONMENT=development
# GYRA_USER_DATABASE_URL=sqlite:///data/gyra_user.db
# GYRA_USER_PUBLIC_BASE_URL=https://auth.example.com   # 反代后面必填，影响 redirect_uri
# GYRA_USER_CORS_ORIGINS=["http://localhost:3000"]

# ── 令牌 ──
GYRA_USER_JWT_SECRET=please-change-me-to-a-long-random-string
GYRA_USER_ACCESS_TOKEN_TTL=1800
GYRA_USER_REFRESH_TOKEN_TTL=604800

# ── GitHub OAuth App ──
# https://github.com/settings/developers
# Authorization callback URL: http://localhost:8100/api/v1/auth/oauth/callback
GYRA_USER_GITHUB_CLIENT_ID=
GYRA_USER_GITHUB_CLIENT_SECRET=

# ── 微信开放平台（网站应用）──
# https://open.weixin.qq.com  → 管理中心 → 网站应用 → 授权回调域填 localhost 或你的域名
# 注意: 回调域不带协议和路径，例如 "example.com"
GYRA_USER_WECHAT_APP_ID=
GYRA_USER_WECHAT_APP_SECRET=

# ── 灰度迁移: 换成 Gyra 现有的 session secret，可继续验签旧 token ──
# GYRA_USER_LEGACY_SESSION_SECRET=
